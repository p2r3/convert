{
  "name": "p2r3-convert",
  "version": "0.0.0",
  "private": true,
  "description": "Truly universal browser-based file converter",
  "author": "PortalRunner",
  "type": "module",
  "main": "src/electron.cjs",
  "scripts": {
    "build:assemble": "bun run scripts/build.ts assemble",
    "build:prebuild": "bun run scripts/build.ts prebuild",
    "build:check": "bun run scripts/build.ts check",
    "build:patch": "bun run scripts/build.ts patch",
    "build:add": "bun run scripts/build.ts add",
    "dev": "bun run build:assemble --all && vite",
    "build": "bun run build:assemble --all && tsc && vite build",
    "cache:build": "bun run buildCache.js dist/cache.json --minify",
    "cache:build:dev": "bun run buildCache.js dist/cache.json",
    "preview": "bun run build:assemble --all && vite preview",
    "docker": "bun run docker:build && bun run docker:up",
    "docker:build": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml build --build-arg VITE_COMMIT_SHA=$(git rev-parse HEAD)",
    "docker:up": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml up -d",
    "desktop:build": "bun run build:assemble --all && tsc && IS_DESKTOP=true vite build && bun run cache:build",
    "desktop:preview": "electron .",
    "desktop:start": "bun run desktop:build && bun run desktop:preview",
    "desktop:dist:win": "bun run desktop:build && electron-builder --win --publish never",
    "desktop:dist:mac": "bun run desktop:build && electron-builder --mac --publish never",
    "desktop:dist:linux": "bun run desktop:build && electron-builder --linux --publish never",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "bun run scripts/remove-old.ts && husky"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.3.0",
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@flo-audio/reflo": "^0.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@imagemagick/magick-wasm": "^0.0.44",
    "@mediabunny/aac-encoder": "^1.61.1",
    "@mediabunny/flac-encoder": "^1.61.1",
    "@mediabunny/mp3-encoder": "^1.61.1",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@preact/signals": "^2.11.3",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@stringsync/vexml": "^0.1.12",
    "@toon-format/toon": "^4.1.1",
    "@turbowarp/jszip": "^3.12.0",
    "@types/bun": "^1.4.2",
    "@types/pako": "^3.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.186.0",
    "@vexflow-fonts/academico": "^1.0.1",
    "@vexflow-fonts/bravura": "^1.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "@yowasp/clang": "^22.0.0-git20542-10",
    "bson": "^7.3.3",
    "buffer": "^6.0.3",
    "celaria-formats": "^1.0.2",
    "chess.js": "^1.4.0",
    "comlink": "^4.4.2",
    "confbox": "^0.3.1",
    "dom-to-svg": "^0.12.2",
    "emf-converter": "^4.11.2",
    "epubjs": "^0.3.93",
    "html2canvas": "^1.4.1",
    "imagetracer": "^0.2.2",
    "js-synthesizer": "^1.13.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "less": "^4.9.1",
    "linkedom": "^0.18.13",
    "lucide-preact": "^1.52.0",
    "mediabunny": "^1.61.1",
    "meyda": "^5.6.3",
    "mime": "^4.1.0",
    "mupdf": "^1.28.1",
    "nanotar": "^0.3.0",
    "nbtify": "^2.2.0",
    "opentype.js": "^2.0.0",
    "pako": "^3.0.2",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "^0.20.2",
    "pe-library": "^2.0.1",
    "preact": "^11.0.0",
    "sass": "^1.105.1",
    "svg-pathdata": "^9.0.0",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.15",
    "tippy.js": "^6.3.7",
    "ts-flp": "^1.0.6",
    "use-debounce": "^10.1.1",
    "vexflow": "^5.0.0",
    "vite-plugin-static-copy": "^3.4.0",
    "wabt": "^1.0.39",
    "wavefile": "^11.0.0",
    "woff2-encoder": "^2.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@preact/preset-vite": "^2.10.6",
    "@types/opentype.js": "^1.3.10",
    "@types/pdfkit": "^0.17.6",
    "citty": "^0.2.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "puppeteer": "^25.12.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2"
  },
  "lint-staged": {
    "*": "bun run fmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint --no-error-on-unmatched-pattern"
  },
  "build": {
    "appId": "com.p2r3.convert",
    "executableName": "convert-to-it",
    "artifactName": "convert-to-it-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/electron.cjs",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "productName": "Convert to it!"
}
